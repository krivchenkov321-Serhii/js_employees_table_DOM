var pushNotification = function(posTop, posRight, title, description, type) {
    var message = document.createElement("div");
    var titleMessage = document.createElement("h2");
    var descriptionMessage = document.createElement("p");
    message.classList.add("notification", type);
    message.dataset.qa = "notification";
    titleMessage.classList.add("title");
    titleMessage.textContent = title;
    descriptionMessage.textContent = description;
    message.style.top = "".concat(posTop, "px");
    message.style.right = "".concat(posRight, "px");
    message.append(titleMessage, descriptionMessage);
    document.body.append(message);
    setTimeout(function() {
        message.style.display = "none";
    }, 2000);
};

